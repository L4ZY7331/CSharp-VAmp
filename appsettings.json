{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AppSettings": {
    "SpawnThreadCount": 3,
    "DeleteThreadCount": 10,
    "ProxyFileName": "proxy_list.txt",
    "Headless": true,
    "AutoRestart": false,
    "SpawnIntervalSeconds": 2,
    "WindowWidth": 500,
    "WindowHeight": 300,
    "RestartIntervalSeconds": 1200
  }
}


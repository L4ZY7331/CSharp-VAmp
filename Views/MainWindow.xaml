<Window x:Class="CSharpVAmp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CSharpVAmp.ViewModels"
        mc:Ignorable="d"
        Title="Crude (Sharp) Viewer Amplifier v.1.0.0 by Lazy7331"
        Height="480" Width="700" 
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Left="500" Top="500">
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="200"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="MainTabControl" Grid.Row="0" Margin="0" Height="200"
                    Background="{DynamicResource WindowBackgroundBrush}">
            <TabItem Header="Main Controls">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="170"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="10">
                        <TextBlock Text="Proxies Available" Margin="0,10,0,5"/>
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Width="50" Height="20" Margin="0,5">
                            <TextBlock Text="{Binding ProxiesAvailable}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <CheckBox Content="headless" IsChecked="{Binding Headless}" Margin="0,20,0,0"/>
                        <CheckBox Content="auto restart" IsChecked="{Binding AutoRestart}" Margin="0,5"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="10">
                        <TextBox Text="{Binding ChannelUrl}" Width="250" Margin="0,10,0,5"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Button Content="Spawn 1 instance" Command="{Binding SpawnOneCommand}" Width="120" Margin="0,0,5,0"/>
                            <Button Content="Spawn 3 instances" Command="{Binding SpawnThreeCommand}" Width="120"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Button Content="Destroy 1 instance" Command="{Binding DeleteOneCommand}" Width="120" Margin="0,0,5,0"/>
                            <Button Content="Destroy all instances" Command="{Binding DeleteAllCommand}" Width="120"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="10">
                        <TextBlock Text="Instances" Margin="0,10,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="alive" Grid.Column="0" Margin="0,5"/>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Width="50" Height="20" Grid.Column="2" Margin="0,5">
                                <TextBlock Text="{Binding AliveInstances}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="watching" Grid.Column="0" Margin="0,5"/>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Width="50" Height="20" Grid.Column="2" Margin="0,5">
                                <TextBlock Text="{Binding WatchingInstances}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding CpuUsage}" Margin="0,20,0,0"/>
                        <TextBlock Text="{Binding RamUsage}" Margin="0,5"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Chatting">
                <Grid>
                    <TextBlock Text="Chat functionality available in PRO version" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
                </Grid>
            </TabItem>
            <TabItem Header="About">
                <StackPanel Margin="20">
                    <TextBlock TextWrapping="Wrap" TextAlignment="Center" Margin="0,10">
                        Thank You for your support! The Pro version is now available to everyone as a free executable.
                        We only use GitHub and blueloperlabs.ch. Other sites, users and resellers are fake - be careful!
                        Purchasing recommended proxies helps the project advance.
                    </TextBlock>
                    <TextBlock Margin="0,20">
                        <Hyperlink NavigateUri="https://blueloperlabs.ch/cvamp/tf" RequestNavigate="Hyperlink_RequestNavigate">
                            Get Recommended Proxies
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </TabItem>
        </TabControl>

        <ScrollViewer Grid.Row="1" Margin="20,10,20,10" VerticalScrollBarVisibility="Auto">
            <TextBox Text="{Binding LogText}" 
                     IsReadOnly="True" 
                     FontFamily="Consolas" 
                     FontSize="8"
                     TextWrapping="Wrap"
                     />
        </ScrollViewer>

        <ItemsControl Grid.Row="2" ItemsSource="{Binding InstanceBoxes}" Margin="24,0,24,10">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="5" Columns="50"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{DynamicResource BorderBrush}" 
                            BorderThickness="0.5" 
                            Width="10" 
                            Height="10"
                            Background="{Binding BackgroundColor}"
                            MouseLeftButtonDown="InstanceBox_MouseLeftButtonDown"
                            MouseRightButtonDown="InstanceBox_MouseRightButtonDown"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Grid.Row="3" Margin="0,0,0,10" HorizontalAlignment="Center">
            <Hyperlink NavigateUri="https://blueloperlabs.ch/cvamp/tf" RequestNavigate="Hyperlink_RequestNavigate">
                blueloperlabs.ch/cvamp
            </Hyperlink>
        </TextBlock>
    </Grid>
</Window>

